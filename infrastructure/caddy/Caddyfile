{
    email {$ACME_EMAIL:admin@example.com}
}

{$R_MES_SERVER_NAME} {
    encode zstd gzip
    reverse_proxy nginx:80
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }
}

{$FILES_SERVER_NAME} {
    encode zstd gzip
    reverse_proxy nginx:80
}
