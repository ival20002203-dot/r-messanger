DEBUG=1
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ALLOWED_HOSTS=localhost,127.0.0.1,10.10.10.130,rmes-test
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://10.10.10.130:8000

# Browser UI switch. 0 = browser disabled; R-Mes Desktop stays available.
WEB_ACCESS_ENABLED=1
WEB_ACCESS_MESSAGE=Для работы используйте приложение R-Mes.

POSTGRES_DB=localgram
POSTGRES_USER=localgram
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Registration is ALWAYS verified by email.
CORP_EMAIL_DOMAINS=company.uz,test.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=rmes@your-company.com
EMAIL_HOST_PASSWORD=CHANGE_SMTP_PASSWORD
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=R-Mes <rmes@your-company.com>
EMAIL_TIMEOUT=15

# Optional: require an email code after password on every login.
LOGIN_EMAIL_2FA=0
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# This account is promoted to the highest DEVELOPER role on startup.
BOOTSTRAP_ADMIN_EMAIL=admin@texnopark.uz
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD_NOW
BOOTSTRAP_ADMIN_NAME=Infrastructure Admin

MAX_UPLOAD_MB=100
MESSAGE_RETENTION_DAYS=3650
MONITORING_NOTICE=Корпоративный мессенджер. Сообщения, файлы, входы и административные действия могут сохраняться и проверяться в соответствии с политикой компании.


# Server-side content moderation.
# No hidden client screenshot capture is used: Localgram stores a server-side
# evidence copy/preview of the content actually sent through Localgram.
CONTENT_MODERATION_ENABLED=1
CONTENT_MODERATION_TEXT_ENABLED=1
CONTENT_MODERATION_MEDIA_ENABLED=1
CONTENT_MODERATION_THRESHOLD=0.20
CONTENT_MODERATION_COVERED_THRESHOLD=0.40
CONTENT_MODERATION_VIDEO_FRAMES=10
CONTENT_MODERATION_VIDEO_OCR_FRAMES=4
CONTENT_MODERATION_WORKER_SLEEP=0.25
CONTENT_MODERATION_POLICY_NOTICE=Отправленный контент может автоматически анализироваться средствами корпоративной модерации и сохраняться для проверки уполномоченными администраторами.


# Object storage (MinIO / S3-compatible)
USE_S3_STORAGE=1
MINIO_ROOT_USER=localgram
MINIO_ROOT_PASSWORD=CHANGE_MINIO_PASSWORD
MINIO_BUCKET=localgram-media
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://10.10.10.130:9000
MINIO_REGION=us-east-1
MINIO_URL_EXPIRE_SECONDS=3600

# Antivirus + DLP
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
SECURITY_WORKER_SLEEP=1.0
DLP_ENABLED=1
DLP_MAX_PARSE_MB=25

# Native/mobile token lifetime
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Production reverse-proxy names
R_MES_SERVER_NAME=10.10.10.130
FILES_SERVER_NAME=10.10.10.130
CLIENT_MAX_BODY_SIZE=110m

CONTENT_MODERATION_OCR_ENABLED=1
CONTENT_MODERATION_OCR_LANG=eng+rus

# v7 Production & Reliability
METRICS_ENABLED=1
METRICS_TOKEN=
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SEARCH=120
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_MESSAGES=80
ANTI_SPAM_ENABLED=1
ANTI_SPAM_DUPLICATE_LIMIT=8
ANTI_SPAM_WINDOW_SECONDS=60
FILE_PREVIEW_MAX_MB=25
SCHEDULED_POST_WORKER_SLEEP=2
CLIENT_UPDATE_API_PUBLIC=1

# R-Mes desktop / WebRTC
R_MES_URL=http://10.10.10.130:8000
RTC_ICE_SERVERS_JSON=[]

# WebRTC / calls (v13.3)
TURN_ENABLED=1
TURN_HOST=10.10.10.130
TURN_USERNAME=rmes
TURN_PASSWORD=RMes-Turn-ChangeMe
# Optional: override with a JSON list. Leave [] to use TURN_* above automatically.
RTC_ICE_SERVERS_JSON=[]

# R-Mes 15 mobile push (optional)
PUSH_ENABLED=0
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=uz.rmes.ios
APNS_USE_SANDBOX=1
CALL_RECORDING_MAX_MB=250
ADMIN_EMAIL_2FA_REQUIRED=1

# Call audio is OFF by default. Metadata (who/when/duration/status) is still logged.
CALL_AUDIO_RECORDING_ENABLED=0
